/* DepthWizard viewer — product-style UI */

.dw-app {
  --dw-bg: #070b13;
  --dw-panel: rgba(15, 24, 40, 0.78);
  --dw-panel-solid: #101827;
  --dw-line: rgba(148, 186, 233, 0.16);
  --dw-ink: #eef3fb;
  --dw-muted: #93a4bd;
  --dw-faint: #64748b;
  --dw-accent: #4f8cff;
  --dw-accent-2: #22d3ee;
  --dw-ok: #34d399;
  --dw-err: #f87171;

  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--dw-bg);
  color: var(--dw-ink);
  font-family: 'Inter', system-ui, 'Segoe UI', Roboto, sans-serif;
  overflow: hidden;
}

/* ---------- Top bar ---------- */
.dw-topbar {
  z-index: 10;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14px;
  padding: 12px 20px;
  background: linear-gradient(180deg, rgba(13, 20, 34, 0.92), rgba(10, 16, 28, 0.78));
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--dw-line);
}

.dw-brand {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-right: 8px;
}

.dw-mark {
  width: 38px;
  height: 38px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  font-size: 19px;
  background: linear-gradient(135deg, rgba(79, 140, 255, 0.9), rgba(34, 211, 238, 0.85));
  box-shadow: 0 4px 18px rgba(57, 128, 255, 0.35);
}

.dw-title {
  margin: 0;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.4px;
  line-height: 1.15;
}

.dw-tagline {
  font-size: 11px;
  color: var(--dw-muted);
  letter-spacing: 0.15px;
}

.dw-controls {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

.dw-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 15px;
  border-radius: 10px;
  border: 1px solid var(--dw-line);
  background: rgba(255, 255, 255, 0.04);
  color: var(--dw-ink);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: transform 0.12s ease, background 0.2s ease, border-color 0.2s ease;
}

.dw-btn:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(148, 186, 233, 0.32);
}

.dw-btn:active:not(:disabled) {
  transform: translateY(1px);
}

.dw-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.dw-btn-generate {
  border: none;
  background: linear-gradient(135deg, var(--dw-accent), var(--dw-accent-2));
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6px 20px rgba(57, 128, 255, 0.35);
}

.dw-btn-generate:hover:not(:disabled) {
  background: linear-gradient(135deg, #5d98ff, #3fe0fb);
  box-shadow: 0 8px 26px rgba(57, 128, 255, 0.45);
}

.dw-btn-ghost {
  background: transparent;
  color: var(--dw-muted);
  border-color: var(--dw-line);
}

.dw-file-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  max-width: 220px;
  padding: 7px 11px;
  border-radius: 10px;
  background: rgba(34, 211, 238, 0.08);
  border: 1px solid rgba(34, 211, 238, 0.22);
  font-size: 12px;
  color: var(--dw-ink);
}

.dw-file-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dw-file-clear {
  border: none;
  background: transparent;
  color: var(--dw-muted);
  cursor: pointer;
  font-size: 15px;
  line-height: 1;
  padding: 0 2px;
}

.dw-file-clear:hover {
  color: var(--dw-err);
}

/* ---------- Height scale ---------- */
.dw-scale {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--dw-muted);
  white-space: nowrap;
}

.dw-scale input[type='range'] {
  -webkit-appearance: none;
  appearance: none;
  width: 92px;
  height: 4px;
  border-radius: 4px;
  background: rgba(148, 186, 233, 0.28);
  outline: none;
  cursor: pointer;
}

.dw-scale input[type='range']::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--dw-accent), var(--dw-accent-2));
  border: 2px solid var(--dw-panel-solid);
  box-shadow: 0 0 0 1px var(--dw-accent), 0 2px 8px rgba(0, 0, 0, 0.5);
}

.dw-scale-value {
  min-width: 26px;
  color: var(--dw-ok);
  font-variant-numeric: tabular-nums;
  font-weight: 600;
}

.dw-spacer {
  flex: 1;
}

/* ---------- Scene ---------- */
.dw-scene {
  position: relative;
  flex: 1;
  overflow: hidden;
  background:
    radial-gradient(120% 90% at 50% 0%, rgba(42, 90, 180, 0.32) 0%, rgba(42, 90, 180, 0) 60%),
    radial-gradient(90% 70% at 85% 108%, rgba(34, 211, 238, 0.14) 0%, rgba(34, 211, 238, 0) 55%),
    var(--dw-bg);
}

/* ---------- Empty / guided state ---------- */
.dw-empty {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  pointer-events: none;
  background: radial-gradient(70% 60% at 50% 42%, rgba(15, 24, 40, 0.55) 0%, rgba(7, 11, 19, 0) 100%);
}

.dw-empty-card {
  max-width: 560px;
  text-align: center;
  padding: 34px 40px;
  border-radius: 18px;
  background: var(--dw-panel);
  border: 1px solid var(--dw-line);
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(10px);
}

.dw-empty-orb {
  width: 64px;
  height: 64px;
  margin: 0 auto 16px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 30px;
  background: radial-gradient(circle at 32% 28%, rgba(79, 140, 255, 0.85), rgba(34, 211, 238, 0.55) 70%);
  box-shadow: 0 10px 30px rgba(57, 128, 255, 0.4);
}

.dw-empty h2 {
  margin: 0 0 8px;
  font-size: 21px;
  font-weight: 700;
  letter-spacing: -0.2px;
}

.dw-empty p {
  margin: 0 0 20px;
  color: var(--dw-muted);
  font-size: 13.5px;
  line-height: 1.55;
}

.dw-steps {
  display: flex;
  gap: 10px;
  justify-content: center;
}

.dw-step {
  flex: 1;
  padding: 12px 10px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--dw-line);
}

.dw-step-num {
  display: block;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  color: var(--dw-accent-2);
  margin-bottom: 4px;
}

.dw-step-name {
  font-size: 12.5px;
  font-weight: 600;
}

.dw-empty-hint {
  margin-top: 18px;
  font-size: 12px;
  color: var(--dw-faint);
}

/* ---------- Status pill / error ---------- */
.dw-status {
  position: absolute;
  top: 18px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 10px 16px;
  border-radius: 12px;
  font-size: 13px;
  background: var(--dw-panel);
  border: 1px solid var(--dw-line);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
}

.dw-status-error {
  border-color: rgba(248, 113, 113, 0.4);
  color: var(--dw-err);
}

.dw-spinner {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  border: 2px solid rgba(148, 186, 233, 0.25);
  border-top-color: var(--dw-accent-2);
  animation: dw-spin 0.8s linear infinite;
}

@keyframes dw-spin {
  to {
    transform: rotate(360deg);
  }
}

/* ---------- Telemetry HUD ---------- */
.dw-hud {
  position: absolute;
  bottom: 22px;
  left: 22px;
  min-width: 224px;
  padding: 14px 16px;
  border-radius: 14px;
  background: var(--dw-panel);
  border: 1px solid var(--dw-line);
  backdrop-filter: blur(10px);
  font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
  pointer-events: none;
}

.dw-hud-title {
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 1.6px;
  color: var(--dw-muted);
  margin-bottom: 10px;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--dw-line);
  font-family: inherit;
}

.dw-hud-row {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  font-size: 11.5px;
  margin-bottom: 5px;
  color: var(--dw-muted);
}

.dw-hud-val {
  color: var(--dw-ok);
  font-variant-numeric: tabular-nums;
}

.dw-hud-note {
  margin-top: 8px;
  font-size: 9.5px;
  color: var(--dw-faint);
  text-align: right;
}

/* ---------- Hint ---------- */
.dw-hint {
  position: absolute;
  bottom: 24px;
  right: 24px;
  font-size: 11.5px;
  color: var(--dw-faint);
  letter-spacing: 0.2px;
}

/* ---------- Export buttons ---------- */
.dw-export-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 12px;
  border-radius: 999px;
  border: 1px solid var(--dw-line);
  background: rgba(255, 255, 255, 0.04);
  color: var(--dw-ink);
  text-decoration: none;
  font-size: 12px;
  font-weight: 500;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.dw-export-pill:hover {
  background: rgba(255, 255, 255, 0.09);
  border-color: rgba(148, 186, 233, 0.35);
}

/* ---------- Responsive ---------- */
@media (max-width: 740px) {
  .dw-topbar {
    padding: 10px 14px;
    gap: 10px;
  }

  .dw-tagline {
    display: none;
  }

  .dw-scene {
    min-height: 0;
  }

  .dw-empty-card {
    margin: 0 14px;
    padding: 22px 18px;
  }

  .dw-steps {
    flex-direction: column;
  }

  .dw-hint {
    display: none;
  }

  .dw-hud {
    left: 14px;
    bottom: 14px;
  }
}